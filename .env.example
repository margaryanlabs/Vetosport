# VETO Sport provider configuration
# Keep real credentials in Vercel/Supabase deployment secrets. Never commit live keys.

# Football event/live data
SPORTMONKS_API_TOKEN=

# Multi-book odds and historical odds snapshots
THE_ODDS_API_KEY=
THE_ODDS_API_REGIONS=eu
# Comma-separated sport keys consumed by the scheduled live odds worker.
# Keep empty to prevent quota usage until explicitly enabled.
VETO_ODDS_SPORT_KEYS=
VETO_ODDS_MARKETS=h2h,spreads,totals

# Future premium providers
SPORTRADAR_API_KEY=
STATS_PERFORM_API_KEY=

# Persistence (PostgreSQL / Supabase-compatible)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional table namespace for shared Supabase projects (temporary VETO Sport uses veto_sport_)
SUPABASE_TABLE_PREFIX=
# Preferred on shared Supabase: keep admin credentials inside Supabase Edge Functions.
VETO_STORAGE_BRIDGE_URL=
VETO_STORAGE_SECRET=

# Vercel Cron authorization. Keep server-only.
CRON_SECRET=

# Protected server-to-server ingestion\nINGESTION_SECRET=\n\n# Optional application metadata
NEXT_PUBLIC_VETO_ENV=development
